# === Zaire Mobile — variables de entorno ===
# Copiá este archivo a `.env` y completá con los valores de tu Supabase de DESARROLLO.
# (Son los MISMOS valores que zaire-industrial/.env.local: NEXT_PUBLIC_SUPABASE_URL / ANON_KEY.)
# Nunca pongas la service_role key. Solo la anon (pública).

EXPO_PUBLIC_DEV_URL=https://TU-PROYECTO-dev.supabase.co
EXPO_PUBLIC_DEV_ANON=TU_ANON_KEY_DEV

# Módulos habilitados (coma, minúsculas). Vacío = todos.
# Keys válidas (mismas que la webapp): trace,field,crm,stock,assets
# En móvil solo se muestran los curados: field,assets,stock,trace.
EXPO_PUBLIC_ENABLED_MODULES=
